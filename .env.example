# Copy this file to ".env" and fill in your own Supabase project values.
# Find them in your Supabase dashboard: Project Settings > API
# (CRA requires the REACT_APP_ prefix for env vars to reach the browser.)
REACT_APP_SUPABASE_URL=your-project-url-here
REACT_APP_SUPABASE_ANON_KEY=your-anon-public-key-here
